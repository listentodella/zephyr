# QST QMI8660 6-axis IMU driver configuration options
#
# SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
# SPDX-License-Identifier: Apache-2.0

menuconfig QMI8660
	bool "QST QMI8660 6-axis IMU"
	default y
	depends on DT_HAS_QST_QMI8660_ENABLED
	help
	  Enable driver for the QST QMI8660 six-axis IMU.

if QMI8660

config QMI8660_DECODER
	bool "QMI8660 decoder logic"
	default y
	select SENSOR_ASYNC_API
	help
	  Compile the QMI8660 decoder API which allows decoding raw data returned
	  from the sensor.

choice
	prompt "Trigger mode"
	default QMI8660_TRIGGER_NONE if QMI8660_STREAM
	default QMI8660_TRIGGER_GLOBAL_THREAD
	help
	  Specify the type of triggering to be used by the driver.

config QMI8660_TRIGGER_NONE
	bool "No trigger"

config QMI8660_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_QST_QMI8660),int-gpios)
	select QMI8660_TRIGGER

config QMI8660_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_QST_QMI8660),int-gpios)
	select QMI8660_TRIGGER

endchoice

config QMI8660_STREAM
	bool "Use hardware FIFO to stream data"
	select QMI8660_TRIGGER
	default y
	depends on (SPI_RTIO || I2C_RTIO)
	depends on SENSOR_ASYNC_API
	help
	  Use this config option to enable streaming sensor data via RTIO subsystem.

config QMI8660_TRIGGER
	bool

config QMI8660_THREAD_PRIORITY
	int "Thread priority"
	depends on QMI8660_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config QMI8660_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on QMI8660_TRIGGER_OWN_THREAD
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # QMI8660
